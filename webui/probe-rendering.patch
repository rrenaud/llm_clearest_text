+<script lang="ts">
+	// A sentence the boilerplate/filler probes flagged: shown dimmed, never restyled with
+	// bold/italic (the model owns those), with the probe readout on hover.
+	import { probeTooltip } from './probeTooltip';
+
+	export let token: any;
+
+	$: d = token.data ?? {};
+	$: flags = d.flags ?? [];
+	$: tip = [
+		d.boilerplate !== undefined
+			? `<div><b>Boilerplate</b> (trained-in caveat or pleasantry): ${(d.boilerplate * 100).toFixed(0)}%</div>`
+			: '',
+		d.filler !== undefined ? `<div><b>Filler</b> (adds no information): ${(d.filler * 100).toFixed(0)}%</div>` : ''
+	].join('');
+</script>
+
+<!-- prettier-ignore -->
+{#if flags.length}<span use:probeTooltip={tip} class="probe-dim" data-flags={flags.join(' ')}><slot /></span>{:else}<span title={tip.replace(/<[^>]+>/g, ' ')}><slot /></span>{/if}
+
+<style>
+	.probe-dim {
+		opacity: 0.42;
+		transition: opacity 0.15s;
+	}
+	.probe-dim:hover {
+		opacity: 0.85;
+	}
+</style>
