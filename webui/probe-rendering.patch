@@ -0,0 +1,81 @@
+<script lang="ts">
+	// A factual span annotated by internal probes: correctness risk (wavy underline, only
+	// for the flagged tail) and provenance (tint for recalled-from-weights, dotted underline
+	// for numbers the model computed). Hover shows the probe readout and top-k alternatives.
+	import { probeTooltip } from './probeTooltip';
+
+	export let token: any;
+
+	$: d = token.data ?? {};
+	$: flags = d.flags ?? [];
+	$: risky = flags.includes('risk');
+
+	const esc = (s: string) =>
+		String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
+
+	const provLabel: Record<string, string> = {
+		ctx: 'Found in your messages',
+		param: 'Recalled from model weights (not in your messages)',
+		computed: 'Number not in your messages; likely computed by the model'
+	};
+
+	const mark = 'background:rgb(239 68 68 / .35);color:inherit;border-radius:2px;padding:0 2px';
+	// Options at the contested token; the chosen one stays in the list, highlighted.
+	$: options = [
+		...(d.alts ?? []).filter(([t, p]: [string, number]) => t === d.tok || (t !== '' && p >= 0.005)),
+		// A sampled token can fall outside the top-k; list it anyway with its own probability.
+		...(d.p !== undefined && !(d.alts ?? []).some(([t]: [string, number]) => t === d.tok) ? [[d.tok, d.p]] : [])
+	];
+	$: others = options.filter(([t]: [string, number]) => t !== d.tok);
+
+	$: tip = [
+		d.risk !== undefined
+			? `<div><b>${risky ? 'Likely wrong' : 'Correctness probe'}</b>: risk ${(d.risk * 100).toFixed(0)}%${risky ? ' (top tail of spans)' : ''}</div>`
+			: '',
+		d.prov ? `<div>${esc(provLabel[d.prov] ?? d.prov)}</div>` : '',
+		d.alts?.length
+			? `<div style="margin-top:4px">Least certain at <mark style="${mark}">${esc(d.tok ?? '')}</mark>` +
+				(d.p !== undefined && others[0]?.[1] > d.p ? ' <b>not its top choice</b>' : '') +
+				`</div><div style="margin-top:2px;opacity:.8">Next-token options:</div>` +
+				options
+					.map(
+						([t, p]: [string, number]) =>
+							`<div style="display:flex;gap:8px;justify-content:space-between"><code${t === d.tok ? ` style="${mark}"` : ''}>${esc(JSON.stringify(t))}</code><span>${(p * 100).toFixed(1)}%${t === d.tok ? ' (chosen)' : ''}</span></div>`
+					)
+					.join('')
+			: ''
+	].join('');
+</script>
+
+<!-- prettier-ignore -->
+<span use:probeTooltip={tip} class="probe-span" class:probe-risk={risky} class:probe-param={d.prov === 'param'} class:probe-computed={d.prov === 'computed'} class:probe-ctx={d.prov === 'ctx'} data-risk={d.risk}><slot /></span>
+
+<style>
+	.probe-risk {
+		text-decoration-line: underline;
+		text-decoration-style: wavy;
+		text-decoration-color: rgb(239 68 68 / 0.85);
+		text-decoration-thickness: 1.5px;
+		text-underline-offset: 3px;
+		cursor: help;
+	}
+	/* The contested token inside the span (where the alternatives come from). */
+	.probe-risk :global(.probe-tok) {
+		background: rgb(239 68 68 / 0.18);
+		border-bottom: 2px solid rgb(239 68 68 / 0.9);
+		border-radius: 2px;
+	}
+	.probe-span:not(.probe-risk) :global(.probe-tok) {
+		border-bottom: 1px dashed rgb(156 163 175 / 0.8);
+	}
+	.probe-param {
+		background: rgb(168 85 247 / 0.08);
+		border-radius: 3px;
+	}
+	.probe-computed:not(.probe-risk) {
+		text-decoration-line: underline;
+		text-decoration-style: dotted;
+		text-decoration-color: rgb(59 130 246 / 0.8);
+		text-underline-offset: 3px;
+	}
+</style>
