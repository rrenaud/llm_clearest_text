diff --git a/src/lib/utils/marked/probe-extension.ts b/src/lib/utils/marked/probe-extension.ts
new file mode 100644
index 0000000..90a93fd
--- /dev/null
+++ b/src/lib/utils/marked/probe-extension.ts
@@ -0,0 +1,47 @@
+// Inline tags emitted by the probed model server (llm_clearest_text/server/probed_server.py):
+//   <probe-s d="...">sentence</probe-s>   sentence-level signals (boilerplate, filler)
+//   <probe d="...">span</probe>           span-level signals (correctness risk, provenance)
+//   <probe-t d="">piece</probe-t>         inside a span: the least-certain token (where alternatives come from)
+// `d` is URL-encoded JSON.
+
+const decode = (d: string) => {
+	try {
+		return JSON.parse(decodeURIComponent(d));
+	} catch {
+		return {};
+	}
+};
+
+const probeRule = (tag: string, type: string) => {
+	const rule = new RegExp(`^<${tag} d="([^"]*)">([\\s\\S]*?)</${tag}>`);
+	return {
+		name: type,
+		level: 'inline' as const,
+		start(src: string) {
+			const i = src.indexOf(`<${tag} `);
+			return i < 0 ? undefined : i;
+		},
+		tokenizer(this: any, src: string) {
+			const match = rule.exec(src);
+			if (!match) return;
+			return {
+				type,
+				raw: match[0],
+				data: decode(match[1]),
+				tokens: this.lexer.inlineTokens(match[2])
+			};
+		},
+		renderer(this: any, token: any) {
+			return this.parser.parseInline(token.tokens);
+		}
+	};
+};
+
+export const stripProbeTags = (content: string) =>
+	content.replace(/<\/?probe(?:-[st])?(?: d="[^"]*")?>/g, '');
+
+export default function () {
+	return {
+		extensions: [probeRule('probe-s', 'probeSentence'), probeRule('probe-t', 'probeToken'), probeRule('probe', 'probeSpan')]
+	};
+}
