@@ -0,0 +1,24 @@
+// Svelte action: attach a tippy tooltip with sanitized HTML content. Used instead of the shared
+// Tooltip component, whose template adds whitespace around its slot (visible inside inline text).
+import DOMPurify from 'dompurify';
+import tippy from 'tippy.js';
+
+export function probeTooltip(node: HTMLElement, content: string) {
+	const instance = tippy(node, {
+		content: DOMPurify.sanitize(content),
+		allowHTML: true,
+		placement: 'top',
+		touch: true,
+		theme: 'dark',
+		arrow: false,
+		offset: [0, 4]
+	});
+	return {
+		update(next: string) {
+			instance.setContent(DOMPurify.sanitize(next));
+		},
+		destroy() {
+			instance.destroy();
+		}
+	};
+}
